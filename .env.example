# ─────────────────────────────────────────────────────────────
# Azure OpenAI — used ONLY by the server-side AI proxy (server/index.js)
# for the RC-Card extraction flow (GPT-4o vision). The key never
# reaches the browser. Copy this file to `.env` and fill in values.
# ─────────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Port the AI proxy listens on (Vite proxies /api -> this).
API_PORT=8787
